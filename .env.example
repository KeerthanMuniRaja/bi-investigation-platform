# Settings for the Python API. Copy to .env (never commit .env).
# Leave everything empty to run locally with no sign-in (SQLite + local files).
# Hosted on Render, these are set in render.yaml / the service's Environment tab.

# --- Sign-in with username + password (accounts are kept in the database) ---
BIP_AUTH=password
# Long random value that signs sign-in tokens; the same on every API server.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BIP_SECRET_KEY=
BIP_ALLOW_SIGNUP=true
BIP_SESSION_DAYS=7

# --- Sessions: Power BI dashboards are hard-deleted when the session ends ---
# (sign-out, this many minutes with the site closed, or the sign-in expiring)
BIP_SESSION_IDLE_MINUTES=30
# "false" keeps dashboards across sessions
# BIP_TEMPORARY_DASHBOARDS=true

# --- Database: Neon Postgres (Dashboard -> Connect -> Connection pooling on) ---
# Also keeps uploaded Excel/CSV files (table bip.file_parts) unless a bucket is set below.
DATABASE_URL=postgresql://neondb_owner:YOUR-PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
BIP_DB_POOL_SIZE=3

# --- Memory: match the server plan (Render free/starter 512, standard 2048) ---
# BIP_MEMORY_LIMIT_MB=512

# --- Optional: a storage bucket for files instead of the database ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=bip-files
# BIP_FILE_STORAGE=local | database | r2 | supabase   (default: the first one configured)

# --- The website's address: allowed to call this API ---
BIP_WEB_URL=https://your-app.vercel.app
