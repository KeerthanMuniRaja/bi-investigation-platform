# Settings for the Python API. Copy to .env (never commit .env).
# Leave everything empty to run locally with no sign-in (SQLite + local files).

# --- Supabase project (Project Settings → API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "service_role" / secret key: server only, never put it in the web app
SUPABASE_SERVICE_ROLE_KEY=
# Only if your project still uses the legacy shared JWT secret; leave empty
# for the newer JWT signing keys (checked automatically)
SUPABASE_JWT_SECRET=

# --- Database (Project Settings → Database → Connection string → URI) ---
# Use the "Session pooler" string (port 5432) and put your database password in it
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Who may sign in (optional; empty = any Google account) ---
BIP_ALLOWED_DOMAINS=
BIP_ALLOWED_EMAILS=

# --- Web app address: allowed to call this API, and where / sends people ---
BIP_CORS_ORIGINS=https://your-app.vercel.app
BIP_WEB_URL=https://your-app.vercel.app

# Optional
# BIP_STORAGE_BUCKET=bip-files
# BIP_DATA_DIR=./data          (local cache of uploaded files)
