# Settings for the Python API. Copy to .env (never commit .env).
# Leave everything empty to run locally with no sign-in (SQLite + local files).

# --- Sign-in with username + password (accounts are kept in the database) ---
BIP_AUTH=password
# Long random value that signs sign-in tokens; the same on every API server.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BIP_SECRET_KEY=
BIP_ALLOW_SIGNUP=true
BIP_SESSION_DAYS=7

# --- Database: Neon Postgres (Dashboard -> Connect -> "Pooled connection") ---
DATABASE_URL=postgresql://neondb_owner:YOUR-PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# "false" once supabase/migrations/*.sql (the schema) has been run on the database
BIP_DB_AUTO_SCHEMA=true
BIP_DB_POOL_SIZE=3

# --- File storage: Cloudflare R2 (R2 -> Manage API tokens) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bip-files
# R2_ENDPOINT=https://<account>.eu.r2.cloudflarestorage.com   (only for EU-jurisdiction buckets)

# Power BI files: after reading, only a snapshot is kept and the original deleted.
# "true" keeps originals (needed only to reconcile against a visual's computed values).
# BIP_KEEP_MODEL_FILES=false

# --- The website's address: allowed to call this API and to upload to the bucket ---
BIP_WEB_URL=https://your-app.vercel.app
