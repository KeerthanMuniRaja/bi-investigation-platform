# Settings for the web app. Copy to .env.local for local development; on
# Vercel add them under Project → Settings → Environment Variables.

# Where the Python API (../app) is reachable from the browser.
# Local: http://127.0.0.1:8000   Hosted: https://your-api.example.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase project (Connect → App frameworks, or Project Settings → API Keys).
# Leave both empty to run with no sign-in. The publishable key (sb_publishable_…)
# is safe in the browser; NEVER put the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
