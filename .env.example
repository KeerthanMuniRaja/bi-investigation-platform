# Settings for the Python API. Copy to .env (never commit .env).
# Leave everything empty to run locally with no sign-in (SQLite + local files).

# --- Sign-in with username + password (accounts are kept in the database) ---
BIP_AUTH=password
# Long random value that signs sign-in tokens. Set the same value on every API
# server. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
BIP_SECRET_KEY=
# "false" = people can't create their own accounts (add them with scripts/create_user.py)
BIP_ALLOW_SIGNUP=true
# How long a sign-in lasts, in days
BIP_SESSION_DAYS=7

# --- Cloud database: Supabase Postgres ---
# Connect → Transaction pooler URI (port 6543) on Vercel; Session pooler (5432) elsewhere.
# Put your database password in it. Empty = local SQLite file.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# "false" once you've run supabase/migrations/*.sql in Supabase yourself
BIP_DB_AUTO_SCHEMA=true
# connections per API instance (keep small on Vercel)
# BIP_DB_POOL_SIZE=3

# --- Cloud file storage: Supabase Storage (optional) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# secret / service_role key: server only, never put it in the web app
SUPABASE_SERVICE_ROLE_KEY=
# BIP_STORAGE_BUCKET=bip-files

# --- Web app address: allowed to call this API, and where / sends people ---
BIP_CORS_ORIGINS=https://your-app.vercel.app
BIP_WEB_URL=https://your-app.vercel.app

# Optional: local cache of uploaded files
# BIP_DATA_DIR=./data
