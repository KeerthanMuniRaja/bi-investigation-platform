# Settings for the web app. Copy to .env.local for local development; on
# Vercel add them under Project → Settings → Environment Variables.

# Where the Python API (../app) is reachable from the browser.
# Local: http://127.0.0.1:8000   Hosted: https://your-api.example.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Sign-in (username + password) is switched on by the API (BIP_AUTH=password);
# the web app needs no setting for it.
