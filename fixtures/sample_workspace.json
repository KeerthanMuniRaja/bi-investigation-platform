    {
      "id": "M_STOCKAVAIL",
      "model_id": "MOD001",
      "name": "Stock Availability",
      "dax_expression": "DIVIDE(COUNTROWS(FILTER(Stock, Stock[Quantity] > 0)), COUNTROWS(Stock))",
